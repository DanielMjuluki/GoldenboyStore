# ── Data store ──────────────────────────────────────────────────────────────
# Leave SHEET_ID unset to use the in-memory data store (fine for local dev).
# Set it to switch to Google Sheets as the real backend.
SHEET_ID=
# One of the two below (base64 is what you'll actually use on Vercel, since
# it has no persistent filesystem to point a key-file path at):
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# ── Admin dashboard (/admin/products) ───────────────────────────────────────
ADMIN_API_KEY=

# ── PayFast (checkout) ───────────────────────────────────────────────────────
# From your PayFast merchant dashboard, once you've created the account.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Optional but recommended — set the same passphrase in PayFast's dashboard
# under Settings → Integration.
PAYFAST_PASSPHRASE=
# "sandbox" (default, safe to test with) or "live" once you're ready to
# accept real payments.
PAYFAST_MODE=sandbox

# ── Email (order confirmations + admin notifications) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Every new order/quote is forwarded here. Defaults to goldenboymj@gmail.com
# if left unset.
ADMIN_EMAIL=goldenboymj@gmail.com

# ── Rate limiting (optional) ────────────────────────────────────────────────
# Without these, rate limiting falls back to in-memory (fine for a single
# instance, resets on redeploy). Free tier available at upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Social stats (/api/social-media) ────────────────────────────────────────
YOUTUBE_API_KEY=
TIKTOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
KICK_CHANNEL_SLUG=
